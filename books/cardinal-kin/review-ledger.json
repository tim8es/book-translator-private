        "findings": [
          {
            "id": "meaning-1",
            "category": "meaning",
            "severity": "major",
            "detail": "The source says that the few people who know of Cardinal’s existence would never connect him to his alter ego. «Немногие ... никогда бы не связали» changes that relationship between the small group and the negation, weakening or reversing the point. Render it as, for example, «те немногие, кто знает о его существовании, никогда бы не связали его с его альтер эго».",
            "resolved": false,
            "source_anchor": {
              "quote": "the few who know of his existence would never connect him with his alter ego.",
              "occurrence": 0
            },
            "translation_anchor": {
              "quote": "немногие, кто знает о его существовании, никогда бы не связали его с его альтер эго.",
              "occurrence": 0
            },
            "resolves": null
          },
          {
            "id": "meaning-2",
            "category": "meaning",
            "severity": "minor",
            "detail": "The source specifies that Ra’s plans are for the near future. «Будущих планах» omits that imminence; retain the timing, for example by saying «о ближайших планах Ра’са насчёт Дэмиана».",
            "resolved": false,
            "source_anchor": {
              "quote": "warning her of Ra’s future plans for Damian in the near future.",
              "occurrence": 0
            },
            "translation_anchor": {
              "quote": "предупреждает о будущих планах Ра’са насчёт Дэмиана.",
              "occurrence": 0
            },
            "resolves": null
          }
        ]
