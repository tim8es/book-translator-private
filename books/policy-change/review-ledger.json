        "findings": [
          {
            "id": "marlene-question-becomes-statement",
            "category": "meaning",
            "severity": "major",
            "detail": "В оригинале Марлен именно спрашивает «Will he know what that means» (нарочно без вопросительного знака), а не утверждает, что Петров поймёт. Русское «Он поймёт, о чём речь, — ответила Марлен» изменяет речевой акт; вернуть вопросительную конструкцию, сохранив намеренное отсутствие знака вопроса.",
            "resolved": false,
            "source_anchor": {
              "quote": "*Will he know what that means,* she asked, no question mark.",
              "occurrence": 0
            },
            "translation_anchor": {
              "quote": "*Он поймёт, о чём речь*, — ответила Марлен, даже не поставив вопросительный знак.",
              "occurrence": 0
            },
            "resolves": null
          },
          {
            "id": "last-year-before-that-grammar",
            "category": "style",
            "severity": "minor",
            "detail": "Грамматически неполная конструкция «как позапрошлом» при сопоставлении подарков; требуется «как позапрошлом году» / «как двумя годами ранее» без потери контекста.",
            "resolved": false,
            "source_anchor": {
              "quote": "like the year before that, which had apparently also been Bad.",
              "occurrence": 0
            },
            "translation_anchor": {
              "quote": "как позапрошлом, который, судя по всему, тоже оказался Плохой Идеей.",
              "occurrence": 0
            },
            "resolves": null
          },
          {
            "id": "bruce-feet-dimensions",
            "category": "meaning",
            "severity": "minor",
            "detail": "В оригинале высота Брюса превосходит рост Шейна на целый фут (~30 см), ширина — примерно на фут. В переводе явные количественные детали заменены «на целую голову выше и едва ли не настолько же шире». Сохранить преувеличенно конкретную меру из оригинала.",
            "resolved": false,
            "source_anchor": {
              "quote": "Bruce was a foot taller and about a foot wider.",
              "occurrence": 0
            },
            "translation_anchor": {
              "quote": "Брюс на целую голову выше и едва ли не настолько же шире.",
              "occurrence": 0
            },
            "resolves": null
          }
        ]
      }
    },
